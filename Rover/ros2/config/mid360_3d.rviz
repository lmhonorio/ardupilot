    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Trajetoria FAST-LIO1
      Splitter Ratio: 0.5
    Tree Height: 309
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
      - /Orbit1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: Mapa 3D acumulado
