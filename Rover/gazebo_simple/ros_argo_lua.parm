# Simulation-only starting profile for the ROS Argo rover; not an autotune.
SCR_ENABLE 1
SCR_USER5 2
SCR_HEAP_SIZE 204800
SCR_VM_I_COUNT 10000
MOT_PWM_TYPE 0
WRC_ENABLE 0
WP_SPEED 0.4
WP_RADIUS 0.2
WP_ACCEL 0.4
WP_JERK 1
WP_PIVOT_ANGLE 60
WP_PIVOT_RATE 30
ATC_ACCEL_MAX 0.5
ATC_DECEL_MAX 0.5
ATC_STR_RAT_MAX 60
ATC_STR_ACC_MAX 90
ATC_STR_RAT_FF 0.2
ATC_STR_RAT_P 0.2
ATC_STR_RAT_I 0.2
