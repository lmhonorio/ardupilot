{
  "glim_ros": {
    "enable_local_mapping": true,
    "enable_global_mapping": true,
    "keep_raw_points": false,
    "imu_time_offset": 0.0,
    "points_time_offset": 0.0,
    "acc_scale": 1.0,
    "imu_frame_id": "glim_imu",
    "lidar_frame_id": "glim_lidar",
    "base_frame_id": "glim_imu",
    "odom_frame_id": "glim_odom",
    "map_frame_id": "glim_map",
    "publish_imu2lidar": true,
    "tf_time_offset": 1e-06,
    "extension_modules": [
      "librviz_viewer.so"
    ],
    "imu_topic": "/rover_argo_N1/Instance1/livox/imu",
    "points_topic": "/glim/input/points",
    "image_topic": "/glim/unused_image",
    "imu_qos": {
      "profile": "sensor_data",
      "depth": 1000
    },
    "points_qos": {
      "profile": "sensor_data"
    },
    "image_qos": {
      "profile": "sensor_data"
    }
  }
}
