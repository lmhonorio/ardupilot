Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: glim_map
    Frame Rate: 20
    Background Color: 35; 35; 35
  Displays:
    - Class: rviz/Grid
      Name: Grade
      Enabled: true
      Plane: XY
      Cell Size: 1
    - Class: rviz/PointCloud2
      Name: GLIM mapa global corrigido
      Enabled: true
      Topic: /glim_ros/map
      Queue Size: 1
      Style: Points
      Size (Pixels): 3
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz/PointCloud2
      Name: GLIM varredura atual
      Enabled: true
      Topic: /glim_ros/points
      Queue Size: 1
      Style: Points
      Size (Pixels): 4
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 220; 60
    - Class: rviz/Pose
      Name: GLIM pose corrigida
      Enabled: true
      Topic: /glim_ros/pose
      Shape: Axes
    - Class: rviz/TF
      Name: Referenciais GLIM
      Enabled: false
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 15
      Pitch: 0.65
      Yaw: 0.6
      Focal Point: {X: 0, Y: 0, Z: 0}
Window Geometry:
  Width: 1280
  Height: 800
